// Cloudflare Worker «jusslos-mcp»: MCP-server for norske lover på https://mcp.jusslos.no/mcp.
// Cloudflare bygger fra dette repoet ved push til main (Workers Builds):
//   Rotmappe:       mcp
//   Byggekommando:  (ingen)
//   Deploykommando: npx wrangler deploy
// Ingen hemmeligheter. D1-databasen «jusslos» fylles hver natt av synken i dnomade/lovfinner (samme skjema).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jusslos-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.jusslos.no", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jusslos",
      "database_id": "1e6ad164-db42-404f-a259-25530fef1823"
    }
  ],
  // Maks 60 kall per minutt per IP-adresse mot /mcp.
  // Bruksstatistikk: verktøynavn, klient, tid og antall treff til Workeren «ipaas-click» (se src/maling.ts).
  // Søkeord, argumenter og IP-adresser sendes ikke. Fjern linjen i en egen kopi av koden.
  "services": [{ "binding": "STATISTIKK", "service": "ipaas-click", "entrypoint": "McpStats" }],
  "ratelimits": [
    { "name": "BEGRENSNING", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    // /mcp/ver2 (Code Mode): 20 kall per minutt per IP, og høyst 20 kjøringer av kode i minuttet samlet.
    { "name": "BEGRENSNING_VER2", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
    { "name": "BEGRENSNING_VER2_KODE", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Sandkassen for /mcp/ver2: hver kjøring av kode går i en egen Dynamic Worker uten nettilgang.
  "worker_loaders": [{ "binding": "LOADER" }],
  // VER2 («av» slår av /mcp/ver2) settes i Cloudflare-panelet og skal overleve deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
