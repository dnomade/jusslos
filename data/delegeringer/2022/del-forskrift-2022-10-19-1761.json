   "type": "seksjon",
   "id": "kapittel-1",
   "navn": "kapI",
   "overskrift": "I",
   "innhold": [
    {
     "type": "tekst",
     "tekst": "Finansdepartementets myndighet etter lov 11. mars 2022 nr. 9 om lov om inn- og utførsel av varer (vareførselsloven) til å gi forskrift, delegeres til Tolletaten. Delegeringen omfatter ikke myndighet etter lovens § 1-2 sjette ledd og kapittel 13 Handelstiltak."
    }
   ]
  },
