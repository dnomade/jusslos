{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dnomade/jusslos/schema/manifest.schema.json",
  "title": "Manifest",
  "description": "Endringssignal for datasettet. Filen endres bare når minst ett dokument er nytt, endret eller fjernet.",
  "type": "object",
  "required": ["skjema", "dataversjon", "oppdatert", "antall", "endringer", "kilde", "lisens"],
  "properties": {
    "skjema": {"type": "string"},
    "dataversjon": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[0-9a-f]{8}$"},
    "forrige_dataversjon": {"type": ["string", "null"]},
    "oppdatert": {"type": "string"},
    "antall": {"type": "object", "additionalProperties": {"type": "integer"}},
    "endringer": {
      "type": "object",
      "required": ["nye", "endret", "fjernet", "fil"],
      "properties": {
        "nye": {"type": "integer"}, "endret": {"type": "integer"},
        "fjernet": {"type": "integer"}, "fil": {"type": "string"}
      }
    },
    "kilde": {"type": "object"},
    "lisens": {"type": "string"}
  }
}
